{
  "dataset": {
    "video_backend": "pyav",
    "eval_split": 0.2
  },
  "policy": {
    "type": "diffusion",
    "device": "cuda",
    "push_to_hub": false
  },
  "output_dir": null,
  "job_name": "diffusion_local",
  "seed": 1000,
  "steps": 15000,
  "batch_size": 1,
  "num_workers": 2,
  "prefetch_factor": 2,
  "accelerator": {
    "mixed_precision": "bf16"
  },
  "log_freq": 100,
  "save_freq": 5000,
  "env_eval_freq": 0,
  "eval_steps": 1000,
  "max_eval_samples": 32,
  "wandb": {
    "enable": false
  }
}

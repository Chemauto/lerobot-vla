{
  "dataset": {
    "video_backend": "pyav",
    "eval_split": 0.2
  },
  "policy": {
    "type": "smolvla",
    "path": "checkpoints/smolvla_base",
    "device": "cuda",
    "push_to_hub": false,
    "vlm_model_name": "checkpoints/smolvla_vlm"
  },
  "rename_map": {
    "observation.images.front": "observation.images.camera1",
    "observation.images.wrist": "observation.images.camera2"
  },
  "output_dir": null,
  "job_name": "smolvla_local",
  "seed": 1000,
  "steps": 30000,
  "batch_size": 16,
  "num_workers": 2,
  "prefetch_factor": 2,
  "accelerator": {
    "mixed_precision": "bf16",
    "gradient_accumulation": {
      "steps": 1
    }
  },
  "log_freq": 100,
  "save_freq": 5000,
  "env_eval_freq": 0,
  "eval_steps": 1000,
  "max_eval_samples": 128,
  "wandb": {
    "enable": false
  }
}

{
  "dataset": {
    "repo_id": "local/so101_official_tabletop",
    "root": "data/official_tabletop_50",
    "video_backend": "pyav",
    "eval_split": 0.2
  },
  "policy": {
    "type": "diffusion",
    "device": "cuda",
    "push_to_hub": false,
    "scheduler_warmup_steps": 1000
  },
  "output_dir": null,
  "job_name": "diffusion_matched_act_budget",
  "seed": 1000,
  "steps": 30000,
  "batch_size": 4,
  "num_workers": 2,
  "prefetch_factor": 2,
  "accelerator": {
    "mixed_precision": "bf16",
    "gradient_accumulation": {
      "steps": 2
    }
  },
  "log_freq": 200,
  "save_freq": 6000,
  "env_eval_freq": 0,
  "eval_steps": 2000,
  "max_eval_samples": 128,
  "wandb": {
    "enable": false
  }
}

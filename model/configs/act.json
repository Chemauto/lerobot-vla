{
  "dataset": {
    "video_backend": "pyav",
    "eval_split": 0.2
  },
  "policy": {
    "type": "act",
    "device": "cuda",
    "push_to_hub": false,
    "chunk_size": 50,
    "n_action_steps": 10
  },
  "output_dir": null,
  "job_name": "act_tabletop",
  "seed": 1000,
  "steps": 30000,
  "batch_size": 12,
  "num_workers": 6,
  "prefetch_factor": 2,
  "accelerator": {
    "mixed_precision": "bf16"
  },
  "log_freq": 100,
  "save_freq": 3000,
  "env_eval_freq": 0,
  "eval_steps": 3000,
  "max_eval_samples": 0,
  "wandb": {
    "enable": false
  },
  "save_checkpoint": true
}
